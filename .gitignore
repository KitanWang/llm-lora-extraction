# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# 虚拟环境（uv 创建，不入库）
venv/
.venv/

# 模型与训练产物（体积大，不入库）
outputs/
models/
*.safetensors
*.bin
*.pt
*.gguf

# 数据：原始/中间/大文件不入库，仅保留 seed 与最终评测集
data/raw/
data/interim/
data/processed/
data/*.jsonl
data/*.parquet
!data/seed/*.jsonl

# 报告：图片产物按需提交，日志不入库
reports/*.log
*.log

# 编辑器 / 系统
.idea/
.vscode/
.DS_Store
